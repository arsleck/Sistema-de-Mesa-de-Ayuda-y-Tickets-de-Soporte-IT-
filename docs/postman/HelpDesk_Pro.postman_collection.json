      "value": "admin_soporte"
    },
    {
      "key": "adminPassword",
      "value": "super_secreta_123"
    },
    {
      "key": "employeeUser",
      "value": "empleado_demo"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
